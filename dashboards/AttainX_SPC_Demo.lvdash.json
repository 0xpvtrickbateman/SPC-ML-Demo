{
  "datasets": [
    {
      "name": "replay_daily",
      "displayName": "Replay Daily",
      "queryLines": [
        "SELECT series_id, CAST(run_date AS DATE) AS run_date, evaluation_actual, predicted_count, trailing_mean_baseline FROM demo_catalog.demo_schema.demo_drift_daily WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Recorded replay'"
      ]
    },
    {
      "name": "replay_performance",
      "displayName": "Replay Performance",
      "queryLines": [
        "SELECT series_id, CAST(window_start AS DATE) AS window_start, CAST(window_end AS DATE) AS window_end, window_number, n_actuals, expected_actuals, mae, reference_mae, baseline_mae, bias, review_threshold, status FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Recorded replay'"
      ]
    },
    {
      "name": "replay_latest",
      "displayName": "Replay Latest",
      "queryLines": [
        "SELECT series_id, n_actuals, mae, reference_mae, baseline_mae, status, window_end FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Recorded replay' AND window_number = 2"
      ]
    },
    {
      "name": "replay_errors",
      "displayName": "Replay Errors",
      "queryLines": [
        "SELECT series_id, CAST(window_end AS DATE) AS window_end, mae AS error_count, CONCAT(series_id, ' \u00b7 Model MAE') AS measure FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Recorded replay' UNION ALL SELECT series_id, CAST(window_end AS DATE) AS window_end, baseline_mae AS error_count, CONCAT(series_id, ' \u00b7 Simple baseline MAE') AS measure FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Recorded replay' UNION ALL SELECT series_id, CAST(window_end AS DATE) AS window_end, review_threshold AS error_count, CONCAT(series_id, ' \u00b7 Review threshold') AS measure FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Recorded replay'"
      ]
    },
    {
      "name": "exercise_daily",
      "displayName": "Exercise Daily",
      "queryLines": [
        "SELECT series_id, CAST(run_date AS DATE) AS run_date, evaluation_actual, predicted_count, trailing_mean_baseline FROM demo_catalog.demo_schema.demo_drift_daily WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Performance drift exercise'"
      ]
    },
    {
      "name": "exercise_performance",
      "displayName": "Exercise Performance",
      "queryLines": [
        "SELECT series_id, CAST(window_start AS DATE) AS window_start, CAST(window_end AS DATE) AS window_end, window_number, n_actuals, expected_actuals, mae, reference_mae, baseline_mae, bias, review_threshold, status FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Performance drift exercise'"
      ]
    },
    {
      "name": "exercise_latest",
      "displayName": "Exercise Latest",
      "queryLines": [
        "SELECT series_id, n_actuals, mae, reference_mae, baseline_mae, status, window_end FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Performance drift exercise' AND window_number = 2"
      ]
    },
    {
      "name": "exercise_errors",
      "displayName": "Exercise Errors",
      "queryLines": [
        "SELECT series_id, CAST(window_end AS DATE) AS window_end, mae AS error_count, CONCAT(series_id, ' \u00b7 Model MAE') AS measure FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Performance drift exercise' UNION ALL SELECT series_id, CAST(window_end AS DATE) AS window_end, baseline_mae AS error_count, CONCAT(series_id, ' \u00b7 Simple baseline MAE') AS measure FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Performance drift exercise' UNION ALL SELECT series_id, CAST(window_end AS DATE) AS window_end, review_threshold AS error_count, CONCAT(series_id, ' \u00b7 Review threshold') AS measure FROM demo_catalog.demo_schema.demo_drift_performance WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Performance drift exercise'"
      ]
    },
    {
      "name": "input_change",
      "displayName": "Input Change",
      "queryLines": [
        "SELECT series_id, feature, shift_score, threshold, reference_n, current_n, missing_rate, status FROM demo_catalog.demo_schema.demo_drift_inputs WHERE dataset_id = 'attainx_demo_v2_seed42' AND scenario = 'Recorded replay' AND window_number = 2"
      ]
    },
    {
      "name": "review_queue",
      "displayName": "Review Queue",
      "queryLines": [
        "SELECT series_id, episode_id, CAST(run_date AS DATE) AS run_date, CAST(last_signal_date AS DATE) AS last_signal_date, signal_windows, rule_fired, disposition FROM demo_catalog.demo_schema.review_queue WHERE dataset_id = 'attainx_demo_v2_seed42'"
